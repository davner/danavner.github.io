{
  "name": "danavner.com",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Personal site of Dan Avner.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:admin": "node scripts/check-admin-config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky && git config blame.ignoreRevsFile .git-blame-ignore-revs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davner/danavner.github.io.git"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltia/cms": "0.201.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "^8.20.0",
    "cheerio": "^1.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "impit": "^0.14.3",
    "js-yaml": "^5.2.3",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
